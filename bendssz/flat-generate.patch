+FLAT_SUBS = [
+    ('_dump(', '_flat('), ('_du_took(', '_fl_took('), ('_du(', '_fl('), ('_du_fin(', '_fl_fin('),
+    ('O.dump_le(', 'O.flat_le('), ('O.dump_bool(', 'O.flat_bool('), ('O.dump_u64(', 'O.flat_u64('),
+    ('O.dump_words_n(', 'O.flat_words_n('), ('O.dump_words(', 'O.flat_words('), ('O.dump_bits_n(', 'O.flat_bits_n('),
