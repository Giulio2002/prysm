+def _flatten(lines):
+    out = []
+    for l in lines:
+        for a, b in FLAT_SUBS:
+            l = l.replace(a, b)
+        out.append(l)
+    return out
+
+
+def emit_flat(s, w):
+    """`{p}_flat(o, t)`: the dump again with one list item per 32-bit word instead of per byte
+    (bendssz FFI: the C stream is the items' little-endian words). Leaves are padded to whole words."""
+    buf = []
+    emit_dump(s, buf.append)
+    for l in _flatten(buf):
+        w(l)
+
+
+def emit_flat_fields(w, p, R, F):
+    buf = []
+    emit_dump_fields(buf.append, p, R, F)
+    for l in _flatten(buf):
+        w(l)
+
